{
  "name": "growthcoder-portfolio-v2",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @growthcoder/api dev",
    "dev:cms": "pnpm --filter @growthcoder/cms dev",
    "dev:web": "pnpm --filter @growthcoder/web dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "clean": "turbo clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.2",
    "typescript": "^5.6.3"
  }
}
